def main():
    global EXTS
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("spec", nargs="?", default="pipeline.spec.json")
    ap.add_argument("--port", type=int, default=8766)
    ap.add_argument("--init", action="store_true", help="crea una spec di esempio")
    ap.add_argument("--root", default=".", help="radice del codice a cui puntano le ancore (default: cartella corrente)")
    ap.add_argument("--check", action="store_true", help="controlla le ancore contro il codice, stampa il rapporto, esce con 1 se qualcosa e' rotto")
    ap.add_argument("--refresh-cmd", default="", help="command that regenerates the spec: enables the Refresh button")
    ap.add_argument("--run-cmd", default="", help="command (python run.py <repo> <blueprint.js> <state dir>) that runs notes in a git worktree: enables the Run button")
    ap.add_argument("--rules-cmd", default="", help="command (python rules.py <repo> <rules.json>) that checks architecture rules: enables the Rules section")
    ap.add_argument("--ask-cmd", default="", help="command (python ask.py <repo>) that answers questions about a component: enables the Ask box")
    ap.add_argument("--plan-cmd", default="", help="command (python plan.py <repo> <state dir>) that turns notes into an architecture plan: enables Plan changes")
    ap.add_argument("--code-ext", default=".py", help="comma-separated extensions that count as code, e.g. .py,.tf,.yaml (default .py)")
    ap.add_argument("--sigilla", action="store_true", help="memorizza lo stato attuale del codice ancorato come verificato")
    A = ap.parse_args()
    EXTS = tuple(e.strip() for e in A.code_ext.split(",") if e.strip())
    if A.init:
        if os.path.exists(A.spec): sys.exit(f"{A.spec} esiste gia'")
        json.dump(ESEMPIO, open(A.spec, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
        return print(f"Creato {A.spec}. Avvia: {os.path.basename(sys.argv[0])} {A.spec}")
    spec_path = os.path.abspath(A.spec)
    if not os.path.exists(spec_path): sys.exit(f"{spec_path} non trovato. Crea un esempio con --init")
    nota_dir = os.path.join(os.path.dirname(spec_path), ".pipeline-viewer"); nota_file = os.path.join(nota_dir, "note.json")
    TOKEN, BOOT, LOCK = secrets.token_urlsafe(24), secrets.token_hex(4), threading.Lock()
    cache = {"m": None, "dati": None}
    root, sigilli_file = os.path.abspath(A.root), os.path.join(nota_dir, "sigilli.json")
    pos_file = os.path.join(nota_dir, "posizioni.json")  # {vista: {id nodo: [x, y]}} dei nodi trascinati a mano; la spec non si tocca

    RF = {"running": False, "ok": None, "tail": ""}

    def stato_refresh():
        last = os.stat(spec_path).st_mtime
        return {"enabled": bool(A.refresh_cmd), "running": RF["running"], "ok": RF["ok"], "tail": RF["tail"], "last": last,
                "stale": max(file_py(root).values(), default=0) > last}  # a .py newer than the spec: the blueprint is out of date

    def lancia_refresh():
        def run():
            try:
                r = subprocess.run(A.refresh_cmd, shell=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=1800)
                RF.update(ok=r.returncode == 0, tail=(r.stderr or r.stdout).strip()[-300:])
            except Exception as e:  # timeout or command not runnable
                RF.update(ok=False, tail=str(e)[:300])
            RF["running"] = False
        with LOCK:
            if RF["running"]: return
            RF.update(running=True, ok=None, tail="")
        threading.Thread(target=run, daemon=True).start()

    RN = {"running": False, "ok": None, "tail": ""}
    run_file = os.path.join(nota_dir, "run.json")  # written by the run command when a run finishes; deleted on apply/discard

    def leggi_run():
        try: return json.load(open(run_file, encoding="utf-8"))
        except (OSError, ValueError): return None

    def scrivi_note(note):
        os.makedirs(nota_dir, exist_ok=True)
        with open(nota_file + ".tmp", "w", encoding="utf-8") as f: json.dump(note, f, ensure_ascii=False, indent=1)
        os.replace(nota_file + ".tmp", nota_file)

    def set_stato(ids, st, risposta=None):  # LOCK held by the caller; ids=None: every note in progress
        note = leggi_note()
        for n in note:
            if n["id"] in ids if ids is not None else n.get("stato") == "in lavorazione":
                n["stato"] = st
                if risposta: n["risposta"] = risposta
        scrivi_note(note)

    runs_dir = os.path.join(nota_dir, "runs")  # history: one file per applied or discarded run

    def archivia(res, esito, applicati):  # LOCK held by the caller
        note = [{k: n.get(k) for k in ("id", "target", "titolo", "nota")} for n in leggi_note() if n.get("stato") == "in lavorazione"]
        rec = {"id": datetime.datetime.now().strftime("%Y%m%d-%H%M%S"), "quando": datetime.datetime.now().isoformat(timespec="seconds"), "esito": esito,
               "applicati": applicati, "note": note, "base": res.get("base"), "summary": res.get("summary", ""),
               "groups": [{k: g.get(k) for k in ("id", "title", "files", "diff")} | {"tests": {k: v for k, v in g["tests"].items() if k != "output"}} for g in res["groups"]]}
        os.makedirs(runs_dir, exist_ok=True)
        with open(os.path.join(runs_dir, rec["id"] + ".json"), "w", encoding="utf-8") as f: json.dump(rec, f, ensure_ascii=False)

    def leggi_runs():
        try: names = sorted(os.listdir(runs_dir), reverse=True)[:50]
        except OSError: return []
        out = []
        for n in names:
            try: out.append(json.load(open(os.path.join(runs_dir, n), encoding="utf-8")))
            except (OSError, ValueError): pass
        return out

    def lancia_run(arg):  # LOCK held by the caller; arg: 'run "<prompt file>"' or 'fix'
        def go():
            try:
                r = subprocess.run(f'{A.run_cmd} {arg}', shell=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=2400)
                RN.update(ok=r.returncode == 0, tail=(r.stderr or r.stdout).strip()[-300:])
            except Exception as e:
                RN.update(ok=False, tail=str(e)[:300])
            if not RN["ok"] and not leggi_run():
                with LOCK: set_stato(None, "aperta")  # failed run, nothing left to review: the notes go back to open (a failed fix keeps the run)
            RN["running"] = False
        RN.update(running=True, ok=None, tail="")
        threading.Thread(target=go, daemon=True).start()

    def corri(cmd, timeout=180):
        """Runs a helper command: (ok, stdout) or (False, short error)."""
        try: r = subprocess.run(cmd, shell=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=timeout)
        except subprocess.TimeoutExpired: return False, "timed out"
        return r.returncode == 0, r.stdout.strip() if r.returncode == 0 else (r.stderr or r.stdout).strip()[-300:]

    def con_testo(testo, fn):  # user text goes to the helper through a temp file, never onto the shell line
        os.makedirs(nota_dir, exist_ok=True); fd, p = tempfile.mkstemp(dir=nota_dir, suffix=".txt")
        with os.fdopen(fd, "w", encoding="utf-8") as f: f.write(testo)
        try: return fn(p)
        finally: os.unlink(p)

    stili_file = os.path.join(nota_dir, "stili.json")  # {element id: look overrides}; the spec is never touched
    COLORE = re.compile(r"#[0-9a-fA-F]{3,8}|[a-zA-Z]{3,20}|(?:rgb|hsl)a?\([0-9 ,.%]{1,40}\)")
    CHIAVI = {"nodo": ("bg", "fg", "border", "borderStyle", "radius"), "freccia": ("color", "width", "line", "arrow")}
    SCELTE = {"borderStyle": ("solid", "dashed", "dotted"), "line": ("solid", "dashed", "dotted"), "arrow": ("triangle", "vee", "none", "circle", "diamond", "tee")}

    def leggi_stili():
        try: return json.load(open(stili_file, encoding="utf-8"))
        except (OSError, ValueError): return {}

    def stile_valido(tipo, s):
        """Only whitelisted keys with validated values survive: they end up in CSS and Cytoscape styles. None = reset that key."""
        out = {}
        for k, v in s.items():
            if k not in CHIAVI[tipo]: continue
            if v is None: out[k] = None
            elif k in SCELTE:
                if v in SCELTE[k]: out[k] = v
            elif k in ("radius", "width"):
                if isinstance(v, (int, float)) and not isinstance(v, bool): out[k] = int(min(60 if k == "radius" else 8, max(1 if k == "width" else 0, v)))
            elif isinstance(v, str) and COLORE.fullmatch(v): out[k] = v
        return out

    annot_file = os.path.join(nota_dir, "annotazioni.json")  # free shapes / comments / emoji drawn by the user: {id, vista, kind, x, y, w, h, text, color}
    FORME = ("rect", "ellipse", "diamond", "triangle", "star", "hexagon", "text", "emoji")

    def leggi_annot():
        try: return json.load(open(annot_file, encoding="utf-8"))
        except (OSError, ValueError): return []

    def annot_valida(d):
        """Only the fields we know, with validated values (the text is drawn on a canvas, never as HTML)."""
        out, num = {}, lambda v, lo, hi: isinstance(v, (int, float)) and not isinstance(v, bool) and lo <= v <= hi
        if d.get("kind") in FORME: out["kind"] = d["kind"]
        for k in ("x", "y"):
            if num(d.get(k), -1e5, 1e5): out[k] = round(d[k])
        for k in ("w", "h"):
            if num(d.get(k), 20, 600): out[k] = round(d[k])
        if isinstance(d.get("text"), str) and len(d["text"]) <= 300: out["text"] = d["text"]
        if isinstance(d.get("color"), str) and re.fullmatch(r"#[0-9a-fA-F]{6}", d["color"]): out["color"] = d["color"]
        return out

    PN = {"running": False, "ok": None, "tail": ""}
    plan_file = os.path.join(nota_dir, "plan.json")  # written by the plan command; removed on discard, or when its run is applied/discarded

    def leggi_plan():
        try: return json.load(open(plan_file, encoding="utf-8"))
        except (OSError, ValueError): return None

    def lancia_plan(pf, model):  # LOCK held by the caller
        def go():
            try:
                r = subprocess.run(f'{A.plan_cmd} make "{pf}" {model}', shell=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=900)
                PN.update(ok=r.returncode == 0, tail=(r.stderr or r.stdout).strip()[-300:])
            except Exception as e:
                PN.update(ok=False, tail=str(e)[:300])
            PN["running"] = False
        PN.update(running=True, ok=None, tail="")
        threading.Thread(target=go, daemon=True).start()

    perm_dir = os.path.join(nota_dir, "perm")  # the run command writes <id>.req.json; the answer goes to <id>.res.json

    def leggi_perm():
        out = []
        try:
            for f in sorted(os.listdir(perm_dir)):
                if f.endswith(".req.json") and not os.path.exists(os.path.join(perm_dir, f[:-9] + ".res.json")):
                    try: out.append(json.load(open(os.path.join(perm_dir, f), encoding="utf-8")))
                    except (OSError, ValueError): pass  # still being written
        except OSError: pass
        return sorted(out, key=lambda r: r.get("at", 0))

    def leggi_pos():
        try: return json.load(open(pos_file, encoding="utf-8"))
        except (OSError, ValueError): return {}

    def leggi_sigilli():
        try: return json.load(open(sigilli_file, encoding="utf-8"))
        except (OSError, ValueError): return {}

    def verifica(spec):
        """None se la spec non usa ancore (spec vecchie: nessun controllo), altrimenti (E, esito di controlla)."""
        if not any(b.get("ancore") or any(n.get("ancore") for n in (b.get("interno") or {}).get("nodi", [])) for b in spec["blocchi"]): return None
        E = estrai(root); return E, controlla(spec, E, leggi_sigilli())

    def dati():
        # si ricalcola se cambia la spec o un qualunque .py: la pagina segue il codice
        m = (os.stat(spec_path).st_mtime, hash(frozenset(file_py(root).items())), os.path.getmtime(pos_file) if os.path.exists(pos_file) else 0)
        if cache["m"] != m:
            try:
                spec = json.load(open(spec_path, encoding="utf-8"))
                err = valida(spec)
                v = None if err else verifica(spec)
                cache["dati"] = {"errore": err} if err else costruisci(spec, v and v[1], leggi_pos())
            except (OSError, ValueError) as e:
                cache["dati"] = {"errore": f"Invalid JSON: {e}"}
            cache["m"] = m
        return cache["dati"]

    if A.check or A.sigilla:
        spec = json.load(open(spec_path, encoding="utf-8")); err = valida(spec)
        if err: sys.exit(err)
        v = verifica(spec)
        if not v: sys.exit("la spec non ha «ancore»: niente da controllare")
        E, r = v
        if A.sigilla:
            os.makedirs(nota_dir, exist_ok=True)
            json.dump({s: E["sim"][s]["hash"] for ss in r["sids"].values() for s in ss}, open(sigilli_file, "w", encoding="utf-8"))
            return print(f"sigillati {len({s for ss in r['sids'].values() for s in ss})} simboli")
        cp = r["copertura"]; brutti = {k: x for k, x in r["stati"].items() if x["stato"] != "ok"}
        senza = [k for k, ok in r["archi"].items() if not ok]
        for k, x in brutti.items(): print(f"{x['stato'].upper():16} {k}  {', '.join(x['rotte'])}")
        for k in senza: print(f"{'SENZA PROVA':16} {k}")
        print(f"copertura {cp['coperti']}/{cp['tot']} simboli; non coperti: {', '.join(cp['scoperti'][:10])}{'...' if len(cp['scoperti']) > 10 else ''}")
        sys.exit(1 if brutti or senza else 0)

    def leggi_note():
        try: return json.load(open(nota_file, encoding="utf-8"))
        except (OSError, ValueError): return []

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def send(self, code, body, ctype="application/json"):
            b = body.encode()
            self.send_response(code); self.send_header("Content-Type", ctype + "; charset=utf-8")
            self.send_header("Content-Length", str(len(b))); self.send_header("Cache-Control", "no-store"); self.end_headers()
            try: self.wfile.write(b)
            except (BrokenPipeError, ConnectionResetError): pass
        def j(self, code, o): self.send(code, json.dumps(o, ensure_ascii=False))
        def host_ok(self): return self.headers.get("Host") in (f"127.0.0.1:{A.port}", f"localhost:{A.port}")
        def do_GET(self):
            if not self.host_ok(): return self.j(403, {"errore": "host not allowed"})
            if self.path == "/": return self.send(200, PAGE.replace("__TOKEN__", TOKEN), "text/html")
            if self.path.startswith("/vendor/") and self.path[8:] in VENDOR:
                try: return self.send(200, open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "vendor", self.path[8:]), encoding="utf-8").read(), "application/javascript")
                except OSError: return self.j(404, {"errore": "missing library: also copy the vendor folder"})
            if self.path == "/api/versione": return self.j(200, {"boot": BOOT})
            if self.path == "/api/runs": return self.j(200, {"runs": leggi_runs()})
            if self.path == "/api/pipeline": return self.j(200, {**dati(), "note": leggi_note(), "refresh": stato_refresh(), "perm": leggi_perm(), "plan": {"enabled": bool(A.plan_cmd), "running": PN["running"], "ok": PN["ok"], "tail": PN["tail"], "result": leggi_plan()}, "annot": leggi_annot(), "stili": leggi_stili(), "caps": {"rules": bool(A.rules_cmd), "ask": bool(A.ask_cmd)},
                                                  "run": {"enabled": bool(A.run_cmd), "running": RN["running"], "ok": RN["ok"], "tail": RN["tail"], "result": leggi_run()}})
            if self.path in ("/api/prompt?tipo=modello", "/api/prompt?tipo=note"):  # testo da incollare in Claude Code
                if self.path.endswith("modello"): return self.j(200, {"prompt": prompt_modello(spec_path, root)})
                aperte = [n for n in leggi_note() if n.get("stato", "aperta") == "aperta" and n["target"] in dati().get("meta", {})]
                v = verifica(json.load(open(spec_path, encoding="utf-8")))
                return self.j(200, {"prompt": prompt_note(aperte, *(v or (None, None)), nota_file), "n": len(aperte)})
            if self.path == "/api/rules" and A.rules_cmd:
                ok, out = corri(f"{A.rules_cmd} check")
                return self.j(200, json.loads(out)) if ok else self.j(500, {"errore": out})
            self.j(404, {"errore": "not found"})
        def do_POST(self):
            if not self.host_ok(): return self.j(403, {"errore": "host not allowed"})
            try: d = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length", 0)), 200000)) or b"{}")
            except ValueError: return self.j(400, {"errore": "invalid request"})
            if self.path not in ("/api/nota", "/api/pos", "/api/refresh", "/api/run", "/api/rules", "/api/ask", "/api/annot", "/api/plan", "/api/perm") or not isinstance(d, dict) or not hmac.compare_digest(str(d.get("token", "")), TOKEN):
                return self.j(403, {"errore": "not authorized"})
            if self.path == "/api/pos":
                vista, i, az = str(d.get("vista", "")), str(d.get("id", "")), d.get("azione")
                coord = [d.get("x"), d.get("y")]
                with LOCK:
                    pos = leggi_pos()
                    if az == "reset": pos.pop(vista, None)
                    elif az == "sposta" and dati().get("meta", {}).get((vista + "/" if vista else "") + i, {}).get("tipo") in ("nodo", "esterno", "nota") \
                            and all(isinstance(c, (int, float)) and abs(c) < 1e5 for c in coord):
                        pos.setdefault(vista, {})[i] = coord
                    else: return self.j(400, {"errore": "invalid position"})
                    os.makedirs(nota_dir, exist_ok=True)
                    with open(pos_file + ".tmp", "w", encoding="utf-8") as f: json.dump(pos, f)
                    os.replace(pos_file + ".tmp", pos_file)
                return self.j(200, {"ok": True})
            if self.path == "/api/refresh":
                if not A.refresh_cmd: return self.j(400, {"errore": "refresh not configured"})
                lancia_refresh(); return self.j(200, {"ok": True})
            if self.path == "/api/annot":
                L, vv, ids = [], ("", *dati().get("dettagli", {})), set()
                ok = d.get("azione") == "set" and isinstance(d.get("annot"), list) and len(d["annot"]) <= 300
                for a in d["annot"] if ok else []:
                    f = annot_valida(a) if isinstance(a, dict) else {}
                    if not ({"kind", "x", "y"} <= f.keys() and re.fullmatch(r"[0-9a-f]{8}", str(a.get("id", ""))) and a["id"] not in ids and str(a.get("vista", "")) in vv):
                        ok = False; break
                    ids.add(a["id"]); L.append({"id": a["id"], "vista": str(a.get("vista", "")), "w": 140, "h": 80, "text": "", "color": "#3b6fd4", **f})
                if not ok: return self.j(400, {"errore": "invalid annotations"})
                with LOCK:
                    os.makedirs(nota_dir, exist_ok=True)
                    with open(annot_file + ".tmp", "w", encoding="utf-8") as fh: json.dump(L, fh, ensure_ascii=False)
                    os.replace(annot_file + ".tmp", annot_file)
                return self.j(200, {"annot": L})
            if self.path == "/api/perm":
                i, dec = str(d.get("id", "")), d.get("decision")
                if not re.fullmatch(r"[0-9a-f]{8}", i) or dec not in ("once", "run", "deny") or not os.path.exists(os.path.join(perm_dir, i + ".req.json")):
                    return self.j(400, {"errore": "invalid answer"})
                pr = os.path.join(perm_dir, i + ".res.json")
                with open(pr + ".tmp", "w", encoding="utf-8") as f: json.dump({"decision": dec}, f)
                os.replace(pr + ".tmp", pr)  # atomic: the waiting agent never reads half an answer
                return self.j(200, {"ok": True})
            if self.path == "/api/plan":
                if not A.plan_cmd: return self.j(400, {"errore": "plan not configured"})
                az, res = d.get("azione"), leggi_plan()
                model = d.get("model") if d.get("model") in ("sonnet", "opus", "haiku") else "sonnet"  # whitelist: it goes onto the shell line
                with LOCK:
                    if PN["running"] or RN["running"]: return self.j(400, {"errore": "a plan or a run is in progress"})
                    aperte = [n for n in leggi_note() if n.get("stato", "aperta") == "aperta" and n["target"] in dati().get("meta", {})]
                    if az == "start":
                        if res or leggi_run() or not aperte: return self.j(400, {"errore": "review or discard the current plan or run first" if res or leggi_run() else "no open notes"})
                        os.makedirs(nota_dir, exist_ok=True); pf = os.path.join(nota_dir, "plan-input.json")
                        coms = [a["text"].strip() for a in leggi_annot() if a["kind"] == "text" and a["text"].strip() not in ("", "Comment")][:20]  # loose comments on the canvas
                        with open(pf, "w", encoding="utf-8") as f: json.dump({"notes": [{k: n[k] for k in ("id", "target", "titolo", "nota")} for n in aperte], "comments": coms}, f, ensure_ascii=False)
                        lancia_plan(pf, model); return self.j(200, {"ok": True})
                    if az == "discard":
                        if os.path.exists(plan_file): os.unlink(plan_file)
                        PN.update(ok=None, tail=""); return self.j(200, {"ok": True})
                    if az == "approve" and res and not leggi_run():
                        aperte = [n for n in aperte if n["id"] in res["notes"]]
                        if not aperte: return self.j(400, {"errore": "the planned notes are no longer open"})
                        v = verifica(json.load(open(spec_path, encoding="utf-8"))); pf = os.path.join(nota_dir, "run-prompt.txt")
                        with open(pf, "w", encoding="utf-8") as f:
                            f.write(prompt_note(aperte, *(v or (None, None))) + "\n\nApproved architecture plan: the code must end up with exactly this structure and no other structural change:\n" + "\n".join(res["lines"]))
                        set_stato({n["id"] for n in aperte}, "in lavorazione"); lancia_run(pf)
                        return self.j(200, {"ok": True})
                return self.j(400, {"errore": "invalid action"})
            if self.path == "/api/rules":
                if not A.rules_cmd: return self.j(400, {"errore": "rules not configured"})
                t = d.get("text")
                if d.get("azione") == "add" and isinstance(t, str) and 0 < len(t.strip()) <= 300: ok, out = con_testo(t.strip(), lambda p: corri(f'{A.rules_cmd} add "{p}"'))
                elif d.get("azione") == "del" and re.fullmatch(r"[0-9a-f]{8}", str(d.get("id", ""))): ok, out = corri(f'{A.rules_cmd} del {d["id"]}')
                else: return self.j(400, {"errore": "invalid action"})
                return self.j(200, {"ok": True}) if ok else self.j(400, {"errore": out})
            if self.path == "/api/ask":
                t, q = str(d.get("target", "")), d.get("q")
                tipo, comp = dati().get("meta", {}).get(t, {}).get("tipo"), t.split("/")[0]  # a step inside a block asks about the block
                if not A.ask_cmd or not isinstance(q, str) or not 0 < len(q.strip()) <= 500 or tipo not in CHIAVI or not re.fullmatch(r"[\w>().-]+", comp):
                    return self.j(400, {"errore": "invalid question"})
                model = d.get("model") if d.get("model") in ("sonnet", "opus", "haiku") else "sonnet"  # whitelist: it goes onto the shell line
                ok, out = con_testo(q.strip(), lambda p: corri(f'{A.ask_cmd} "{comp}" "{p}" {model} {"node" if tipo == "nodo" else "edge"}', 300))
                if not ok: return self.j(400, {"errore": out})
                s = out.strip()
                if s.startswith("```"): s = s.strip("`").removeprefix("json").strip()
                try: j = json.loads(s)
                except ValueError: j = None
                if not (isinstance(j, dict) and isinstance(j.get("style"), dict)): return self.j(200, {"answer": out})  # a plain answer
                with LOCK:  # the model asked for a look change: validate, merge, store
                    st, new = leggi_stili(), stile_valido(tipo, j["style"])
                    if j["style"].get("reset") is True: st.pop(t, None); msg = "Default look restored."
                    elif not new: return self.j(200, {"answer": "I could not turn that into a style change I support."})
                    else:
                        cur = {k: v for k, v in {**st.get(t, {}), **new}.items() if v is not None}
                        st.pop(t, None)
                        if cur: st[t] = cur
                        msg = "Look updated: " + ", ".join(f"{k} = {v}" for k, v in new.items() if v is not None) + "."
                    os.makedirs(nota_dir, exist_ok=True)
                    with open(stili_file + ".tmp", "w", encoding="utf-8") as f: json.dump(st, f)
                    os.replace(stili_file + ".tmp", stili_file)
                return self.j(200, {"answer": msg, "stili": st})
            if self.path == "/api/run":
                if not A.run_cmd: return self.j(400, {"errore": "run not configured"})
                az, res = d.get("azione"), leggi_run()
                if az == "check":  # tests of a partial selection: minutes, so outside the lock (notes stay usable meanwhile)
                    if RN["running"] or not res: return self.j(400, {"errore": "no run to check"})
                    g = d.get("groups") if isinstance(d.get("groups"), list) else []
                    keep = [x for x in g if x in {y["id"] for y in res["groups"]}]  # only ids the run itself produced reach the shell
                    if not keep: return self.j(400, {"errore": "select at least one file"})
                    r = subprocess.run(f'{A.run_cmd} check "{",".join(keep)}"', shell=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=1500)
                    if r.returncode: return self.j(500, {"errore": (r.stderr or r.stdout).strip()[-300:]})
                    return self.j(200, {"ok": True})
                with LOCK:
                    if RN["running"]: return self.j(400, {"errore": "a run is in progress"})
                    if az == "start":
                        aperte = [n for n in leggi_note() if n.get("stato", "aperta") == "aperta" and n["target"] in dati().get("meta", {})]
                        if res or leggi_plan() or not aperte: return self.j(400, {"errore": "review or discard the previous run first" if res else "approve or discard the plan first" if leggi_plan() else "no open notes"})
                        os.makedirs(nota_dir, exist_ok=True); pf = os.path.join(nota_dir, "run-prompt.txt")
                        v = verifica(json.load(open(spec_path, encoding="utf-8")))
                        with open(pf, "w", encoding="utf-8") as f: f.write(prompt_note(aperte, *(v or (None, None))))
                        set_stato({n["id"] for n in aperte}, "in lavorazione"); lancia_run(f'run "{pf}"')
                        return self.j(200, {"ok": True})
                    if az == "reopen":  # the notes of a past run become open again, ready for a new run
                        rec = next((x for x in leggi_runs() if x["id"] == d.get("id")), None)
                        if not rec: return self.j(400, {"errore": "unknown run"})
                        set_stato({n["id"] for n in rec["note"]}, "aperta")
                        return self.j(200, {"ok": True})
                    if not res or az not in ("apply", "discard", "fix"): return self.j(400, {"errore": "invalid action"})
                    if az == "fix":
                        lancia_run("fix")
                        return self.j(200, {"ok": True})
                    g = d.get("groups") if isinstance(d.get("groups"), list) else []
                    keep = [x for x in g if x in {y["id"] for y in res["groups"]}] if az == "apply" else []  # only ids the run itself produced reach the shell
                    r = subprocess.run(f'{A.run_cmd} {az} "{",".join(keep)}"', shell=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=300)
                    if r.returncode: return self.j(500, {"errore": (r.stderr or r.stdout).strip()[-300:]})
                    archivia(res, "applied" if az == "apply" else "discarded", keep)
                    RN.update(ok=None, tail="")
                    set_stato(None, "fatta" if az == "apply" else "aperta", "Applied after review" if az == "apply" else None)
                    if az == "apply" and A.refresh_cmd: lancia_refresh()  # the code just changed: redraw the blueprint from it
                return self.j(200, {"ok": True})
            with LOCK:
                note = leggi_note()
                if d.get("azione") == "aggiungi":
                    meta = dati().get("meta", {}); t, testo = d.get("target"), d.get("nota")
                    if t not in meta or not isinstance(testo, str) or not 0 < len(testo.strip()) <= 1000 or len(note) >= 200:
                        return self.j(400, {"errore": "invalid note"})
                    note.append({"id": secrets.token_hex(4), "target": t, "titolo": meta[t]["titolo"], "nota": testo.strip(),
                                 "stato": "aperta", "quando": datetime.datetime.now().isoformat(timespec="seconds")})
                elif d.get("azione") == "elimina":
                    note = [x for x in note if x.get("id") != d.get("id")]
                else:
                    return self.j(400, {"errore": "invalid action"})
                scrivi_note(note)
            self.j(200, {"note": note})

    def riavvia_se_cambia():  # sviluppo dal vivo del tool stesso: se questo file cambia, si riavvia
        src = os.path.abspath(__file__); m0 = os.stat(src).st_mtime
        while True:
            time.sleep(2)
            try:
                if os.stat(src).st_mtime != m0:  # Windows execv joins argv without quoting: an argument with spaces (the --*-cmd ones) would split
                    av = [sys.executable] + sys.argv
                    os.execv(sys.executable, [subprocess.list2cmdline([a]) for a in av] if os.name == "nt" else av)
            except OSError: pass

    srv = ThreadingHTTPServer(("127.0.0.1", A.port), H)
    threading.Thread(target=riavvia_se_cambia, daemon=True).start()
    print(f"http://127.0.0.1:{A.port}/   spec: {spec_path}   note: {nota_file}", flush=True)
    try: srv.serve_forever()
    except KeyboardInterrupt: pass


if __name__ == "__main__":
    main()
