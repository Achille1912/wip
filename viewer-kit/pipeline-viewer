def esc(t):
    return html.escape(str(t), quote=False)


def vista(pid, titolo, nodi, archi, ver=None, posiz=None, gruppi=None, esterni=None):
    """Descrive un grafo per la pagina: ritorna (vista, meta). Nessuna geometria: layout (ELK) e disegno (Cytoscape) stanno nella
    pagina. posiz = {id: [x, y]} sono i nodi che l'utente ha trascinato a mano; "trasversale" = usato da quasi tutti, senza frecce.
    Per farsi capire: un nodo senza frecce interne mostra le sue relazioni vere con altri blocchi (esterni = [{da, altro, dir, et, pr,
    titolo, d}], riquadri "esterno" che si aprono) e, se non ne ha, una nota UML con la sua descrizione. Ogni id di nodo/freccia e'
    pre + k, con k locale (e' la chiave delle posizioni salvate)."""
    posiz = posiz or {}
    ids = [n["id"] for n in nodi]
    nodo = {n["id"]: n for n in nodi}
    righe = {i: str(nodo[i]["testo"]).split("|") for i in ids}
    archi = [a for a in archi if a[0] in nodo and a[1] in nodo and not nodo[a[0]].get("trasversale") and not nodo[a[1]].get("trasversale")]
    succ = {i: [] for i in ids}
    for a, b, *_ in archi: succ[a].append(b)
    stato, indietro = {}, set()  # archi all'indietro = quelli che chiudono un ciclo (visita in profondita')
    def visita(u):
        stato[u] = 1
        for v in succ[u]:
            if stato.get(v) == 1: indietro.add((u, v))
            elif v not in stato: visita(v)
        stato[u] = 2
    sys.setrecursionlimit(10000)
    for i in ids:
        if i not in stato: visita(i)
    pre = f"{pid}/" if pid else ""
    meta, vn, va, vg, grp = {}, [], [], [], {}
    tipo_arco = lambda pr: "flusso" if pr and pr.startswith("grafo") else "uso"  # UML: flusso del grafo (continua) o dipendenza (tratteggiata)
    for g in gruppi or []:  # un nodo sta in un solo riquadro: vale il primo che lo elenca
        mem = [x for x in g.get("nodi", []) if x in nodo and x not in grp]
        if not mem: continue
        gid = f"{pre}#{g['id']}"; tit = g.get("titolo", g["id"])
        for x in mem: grp[x] = gid
        vg.append({"id": gid, "titolo": tit, "colore": g.get("colore", "grigio"), "d": g.get("descrizione", ""), "dir": g.get("direzione", "")})
        meta[gid] = {"tipo": "gruppo", "titolo": tit, "dettaglio": "", "codice": "", "descrizione": g.get("descrizione", ""), "verifica": "", "dentro": titolo}
    for a, b, *rest in archi:
        lab, desc = (rest + ["", ""])[:2]  # arco = [da, a, etichetta?, descrizione?]
        if len(rest) > 3 and rest[3] not in ("", "imports", "depends_on"): lab = lab if lab.lower().startswith(rest[3].rstrip("s")) else f"{rest[3]} · {lab}" if lab else rest[3]  # 6th item: link type, unless the label already starts with it
        eid = f"{pre}{a}>{b}"; pr = ver["archi"].get(eid) if ver else None
        va.append({"id": eid, "a": pre + a, "b": pre + b, "label": lab, "ty": rest[3] if len(rest) > 3 else "", "da": (a, b) in indietro, "senza": pr == "", "k": tipo_arco(pr)})
        meta[eid] = {"tipo": "freccia", "titolo": f"{righe[a][0]} → {righe[b][0]}" + (f" ({lab})" if lab else ""), "dettaglio": ("type: " + rest[3]) if len(rest) > 3 and rest[3] else "", "codice": "", "descrizione": desc,
                     "verifica": "no proof in the code" if pr == "" else pr if pr and pr.startswith("relazione dichiarata") else f"prova nel codice: {pr}" if pr else ""}
    note_txt = {}  # id nodo -> testo della nota UML da attaccargli
    for i in ids:
        n = nodo[i]; v = ver["stati"].get(pre + i) if ver else None
        ver_t = "" if not v or v["stato"] == "ok" else ("Code not found: " + ", ".join(v["rotte"]) if v["rotte"] else "The code of this block changed since the last refresh")
        det = "external system: relations are declared, not verifiable in the code" if n.get("esterno") else " ".join(righe[i][1:])
        if n.get("trasversale") and ver and pre + i in ver.get("usato", {}):
            nomi = [nodo[x]["testo"].split("|")[0] for x in ver["usato"][pre + i] if x in nodo]
            det = "Usato da: " + ", ".join(nomi)
            note_txt[i] = "Usato da: " + ", ".join(nomi[:9]) + (f" e altri {len(nomi) - 9}" if len(nomi) > 9 else "")
        vn.append({"id": pre + i, "k": i, "titolo": righe[i][0], "sotto": " ".join(righe[i][1:]), "tipo": n["tipo"], "d": n.get("descrizione", ""),
                   "w": 300, "h": 66 + 17 * min(6, -(-len(n.get("descrizione") or " ".join(righe[i][1:])) // 36)) + (28 if n.get("descrizione") and len(righe[i]) > 1 else 0),
                   "in": len((n.get("interno") or {}).get("nodi", [])), "lc": n.get("colore", ""), "auto": bool(n.get("auto")),
                   "ultimo": bool(n.get("trasversale")), "gruppo": grp.get(i, ""),
                   "stato": {"rotto": "rotto", "da riverificare": "giallo"}.get(v["stato"], "") if v else ""})
        meta[pre + i] = {"tipo": "nodo", "titolo": righe[i][0], "dettaglio": det, "codice": n.get("codice") or ", ".join(n.get("ancore", []))[:400],
                         "descrizione": n.get("descrizione", ""), "dentro": titolo, "verifica": ver_t}
    for r in esterni or []:  # relazioni vere con altri blocchi, come riquadri "esterno"
        gid = f"{pre}@{r['altro']}"
        if gid not in meta:
            vn.append({"id": gid, "k": "@" + r["altro"], "titolo": r["titolo"], "sotto": "", "tipo": "ext", "d": r["d"], "w": 300, "h": 62 + 17 * min(2, -(-len(r["d"]) // 36)),
                       "auto": False, "ultimo": False, "gruppo": "", "stato": "", "apri": r["altro"]})
            meta[gid] = {"tipo": "esterno", "titolo": r["titolo"], "dettaglio": "block outside this view: double-click to open it", "codice": "",
                         "descrizione": r["d"], "verifica": "", "dentro": titolo, "apri": r["altro"]}
        a, b = (pre + r["da"], gid) if r["dir"] == "out" else (gid, pre + r["da"])
        eid = f"{a}>{b[len(pre):]}" if r["dir"] == "out" else f"{gid}>{r['da']}"
        va.append({"id": eid, "a": a, "b": b, "label": r["et"][:26], "da": False, "senza": False, "k": tipo_arco(r["pr"])})
        meta[eid] = {"tipo": "freccia", "titolo": f"{meta[a]['titolo']} → {meta[b]['titolo']}", "dettaglio": "", "codice": "", "descrizione": "",
                     "verifica": f"prova nel codice: {r['pr']}"}
    conn = {x for e in va for x in (e["a"], e["b"])}
    for i in ids:  # nodo ancora solo: una nota UML con la sua descrizione lo spiega
        txt = note_txt.get(i) or (nodo[i].get("descrizione") if pre + i not in conn else "")
        if not txt: continue
        nid = f"{pre}~{i}"
        vn.append({"id": nid, "k": "~" + i, "titolo": "", "sotto": txt, "tipo": "nota", "d": "", "w": 250, "h": min(170, 28 + 16 * -(-len(txt) // 38)), "auto": False, "ultimo": False,
                   "dopo": bool(nodo[i].get("trasversale")),
                   "gruppo": grp.get(i, ""), "stato": ""})
        va.append({"id": f"{nid}>{i}", "a": pre + i, "b": nid, "label": "", "da": False, "senza": False, "k": "nota"})
        meta[nid] = {"tipo": "nota", "titolo": "Note on " + righe[i][0], "dettaglio": "", "codice": "", "descrizione": txt, "verifica": "", "dentro": titolo}
        meta[f"{nid}>{i}"] = {"tipo": "freccia", "titolo": f"Nota → {righe[i][0]}", "dettaglio": "", "codice": "", "descrizione": "", "verifica": ""}
    pos = {pre + k: p for k, p in posiz.items()}
    return {"titolo": titolo, "nodi": vn, "archi": va, "gruppi": vg, "pos": pos}, meta


def valida(spec):
    """Ritorna un messaggio d'errore leggibile, o ''."""
    def grafo(nodi, archi, dove):
        ids = [n.get("id") for n in nodi]
        if len(set(ids)) != len(ids) or not all(isinstance(i, str) and i and "/" not in i and ">" not in i for i in ids):
            return f"{dove}: id mancanti, doppi o con / e >"
        for n in nodi:
            if n.get("tipo") not in TIPI or not n.get("testo"): return f"{dove}: nodo «{n.get('id')}» senza testo o con tipo non valido (usa {', '.join(TIPI)})"
        for a in archi:
            if len(a) < 2 or a[0] not in ids or a[1] not in ids: return f"{dove}: arco {a} verso un nodo inesistente"
        return ""
    def gruppi(nodi, gr, dove):
        ids = {n["id"] for n in nodi}
        for g in gr or []:
            if not isinstance(g.get("id"), str) or not g["id"] or "/" in g["id"] or ">" in g["id"]: return f"{dove}: gruppo senza id valido"
            if any(x not in ids for x in g.get("nodi", [])): return f"{dove}: il gruppo «{g['id']}» elenca un nodo inesistente"
        return ""
    if not isinstance(spec, dict) or not spec.get("blocchi"): return "la spec deve avere «blocchi»"
    m = grafo(spec["blocchi"], spec.get("archi", []), "schema") or gruppi(spec["blocchi"], spec.get("gruppi"), "schema")
    for b in spec["blocchi"]:
        if not m and b.get("interno"):
            m = grafo(b["interno"].get("nodi", []), b["interno"].get("archi", []), f"interno di {b['id']}") \
                or gruppi(b["interno"].get("nodi", []), b["interno"].get("gruppi"), f"interno di {b['id']}")
    return m


