def sids_di(r, t):
    """Simboli reali di un bersaglio di nota: blocco, nodo interno o freccia (unione dei due estremi)."""
    if ">" not in t: return r["sids"].get(t, [])
    pre, _, ab = t.rpartition("/"); pre = pre + "/" if pre else ""
    return [s for x in ab.split(">") for s in r["sids"].get(pre + x, [])]


def prompt_note(note, E, r, nota_file=None):
    """E, r = None se la spec non ha ancore: le note vanno comunque, senza i simboli di codice."""
    righe = []
    for n in note:
        sim = ", ".join(f"{s} (line {E['sim'][s]['riga']})" for s in sids_di(r, n["target"])[:15]) if E else ""
        righe.append(f"- NOTE {n['id']} on «{n['titolo']}», code: {sim or 'n/a'}\n  {n['nota']}")
    fine = (f"\nThen update {nota_file}: for each note set its state to «fatta» and write in «risposta» what you did (or the answer to the question)."
            if nota_file else "\nFinish with a short summary: for each note, what you changed or the answer to it.")
    return ("The user left these notes on a diagram of the project. Apply them to the code with the minimum change needed; "
            "if a note is only a question, answer it without changing anything. Touch nothing else.\n" + "\n".join(righe) + fine)


VENDOR = {"cytoscape.min.js", "elk.bundled.js", "cytoscape-node-html-label.min.js"}  # librerie del disegno, servite da vendor/ (niente CDN)
SKIP = {"node_modules", "__pycache__", "venv", "site-packages", "dist", "build"}


EXTS = (".py",)  # file extensions that count as code (see --code-ext)


def file_py(root):
    """{percorso relativo: mtime} dei .py del progetto: e' anche l'impronta per accorgersi che il codice e' cambiato."""
    out = {}
    for dp, dn, fn in os.walk(root):
        dn[:] = [d for d in dn if d not in SKIP and not d.startswith(".")]
        for f in fn:
            if f.endswith(EXTS) or f.startswith("Dockerfile"):  # same files as the blueprint's extract.code_files
                p = os.path.join(dp, f)
                try: out[os.path.relpath(p, root).replace(os.sep, "/")] = os.stat(p).st_mtime
                except OSError: pass
    return out


def estrai(root, files=None):
    """Base di verita' deterministica, solo da ast: simboli (funzioni, classi, metodi) con riga e hash, chiamate, import.
    ponytail: le chiamate si risolvono per nome (sovrastima se due funzioni si chiamano uguale), gli import solo
    da radice del progetto; passare a una risoluzione per scope e per pacchetto se serve piu' precisione."""
    files = files if files is not None else file_py(root)
    sim, chiam, imp, flusso = {}, {}, {}, set()
    # "usa" = chiama oppure nomina (es. passa la funzione come argomento: graph.add_node("x", node_x))
    chiamate = lambda nodi: ({c.func.id if isinstance(c.func, ast.Name) else c.func.attr for n in nodi for c in ast.walk(n)
                              if isinstance(c, ast.Call) and isinstance(c.func, (ast.Name, ast.Attribute))}
                             | {c.id for n in nodi for c in ast.walk(n) if isinstance(c, ast.Name) and isinstance(c.ctx, ast.Load)})
    def a_file(parti):
        for c in ("/".join(parti) + ".py", "/".join(parti + ["__init__"]) + ".py"):
            if c in files: return c
    for rel in files:
        if not rel.endswith(".py"):  # Terraform, YAML, shell…: one symbol for the whole file is enough for anchors and drift
            try: src = open(os.path.join(root, rel), encoding="utf-8-sig", errors="replace").read()
            except OSError: continue
            sim[f"{rel}:<modulo>"] = {"file": rel, "riga": 1, "hash": hashlib.sha1(src.encode()).hexdigest()[:12]}; chiam[f"{rel}:<modulo>"] = set(); imp[rel] = set(); continue
        try: src = open(os.path.join(root, rel), encoding="utf-8-sig").read(); tree = ast.parse(src)
        except (OSError, SyntaxError, ValueError): continue
        righe = src.splitlines()
        def visita(nodi, pre):
            for n in nodi:
                if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                    sid = f"{rel}:{pre}{n.name}"
                    sim[sid] = {"file": rel, "riga": n.lineno, "hash": hashlib.sha1("\n".join(righe[n.lineno - 1:n.end_lineno]).encode()).hexdigest()[:12]}
                    if isinstance(n, ast.ClassDef): visita(n.body, f"{pre}{n.name}.")
                    else: chiam[sid] = chiamate(n.body)
        visita(tree.body, "")
        # le istruzioni fuori da ogni funzione (es. app = FastAPI()) stanno in un simbolo <modulo>
        sim[f"{rel}:<modulo>"] = {"file": rel, "riga": 1, "hash": hashlib.sha1(src.encode()).hexdigest()[:12]}
        chiam[f"{rel}:<modulo>"] = chiamate([n for n in tree.body if not isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))])
        dest, pkg = set(), rel.split("/")[:-1]
        for n in ast.walk(tree):
            if isinstance(n, ast.Import): basi = [(a.name.split("."), []) for a in n.names]
            elif isinstance(n, ast.ImportFrom):
                base = (pkg[:len(pkg) - (n.level - 1)] if n.level else []) + (n.module.split(".") if n.module else [])
                basi = [(base, [a.name]) for a in n.names] if n.names else []
            else: continue
            for base, nomi in basi:
                for p in [base] + [base + [x] for x in nomi]:
                    f = a_file(p) if p else None
                    if f and f != rel: dest.add(f)
        imp[rel] = dest
        # adattatore LangGraph: add_node/add_edge/add_conditional_edges dichiarano un flusso tra funzioni che non e' una chiamata
        s = lambda x: x.value if isinstance(x, ast.Constant) and isinstance(x.value, str) else None
        nomi, coppie = {}, []
        for c in ast.walk(tree):
            if not (isinstance(c, ast.Call) and isinstance(c.func, ast.Attribute)): continue
            a = c.args
            if c.func.attr == "add_node" and len(a) == 2 and s(a[0]):  # add_node("x", f) o add_node("x", wrapper("x", f))
                fn = [m.id for m in ast.walk(a[1]) if isinstance(m, ast.Name)]
                if fn: nomi[s(a[0])] = fn[-1]
            elif c.func.attr == "add_edge" and len(a) == 2: coppie.append((s(a[0]), s(a[1])))
            elif c.func.attr == "add_conditional_edges" and len(a) >= 3 and isinstance(a[2], ast.Dict): coppie += [(s(a[0]), s(v)) for v in a[2].values]
        flusso |= {(nomi[x], nomi[y]) for x, y in coppie if x in nomi and y in nomi}
    return {"sim": sim, "chiam": chiam, "imp": imp, "files": files, "flusso": flusso}


def risolvi(a, E):
    """Ancora 'file' o 'file:Classe.metodo' -> simboli reali. Per una classe, anche i suoi metodi."""
    f, _, q = a.partition(":")
    if not q: return [s for s, v in E["sim"].items() if v["file"] == f]
    return [s for s in E["sim"] if s == a or s.startswith(a + ".")]


def prova(E, sa, sb):
    """Perche' c'e' una freccia da A a B? Ritorna (testo, etichetta breve) o None. Prove ammesse: A usa (chiama o nomina)
    un simbolo di B, A importa un file di B, oppure il grafo (LangGraph add_edge) collega le loro funzioni."""
    nome = lambda s: s.rpartition(":")[2].rpartition(".")[2]
    nomi, fb = {nome(s) for s in sb}, {E["sim"][s]["file"] for s in sb}
    usati = sorted(set().union(*(E["chiam"].get(s, set()) for s in sa)) & nomi) if sa else []
    if usati: return "usa " + ", ".join(usati[:3]), usati[0]
    imp = sorted({f for s in sa for f in E["imp"].get(E["sim"][s]["file"], set())} & fb)
    if imp: return "importa " + ", ".join(imp[:3]), "importa"
    fl = sorted({f"{nome(a)} → {n}" for a in sa for n in nomi if (nome(a), n) in E["flusso"]})
    if fl: return "grafo: " + ", ".join(fl[:3]), fl[0]


def ancore_blocco(b):
    return list(b.get("ancore", [])) + [a for n in (b.get("interno") or {}).get("nodi", []) for a in n.get("ancore", [])]


def controlla(spec, E, sigilli=None):
    """Verifica la spec contro il codice. Ritorna {"stati": {id: {stato, rotte}}, "archi": {id: testo della prova, '' se manca},
    "usato": {id trasversale: [chi lo usa]}, "copertura": {tot, coperti, scoperti}}. Stato: ok | rotto (ancora che non esiste
    o mancante) | da riverificare (il codice sotto l'ancora e' cambiato dall'ultima --sigilla)."""
    def stato(ancore):
        rot = [a for a in ancore if not risolvi(a, E)] or (["(nessuna ancora)"] if not ancore else [])
        sids = {s for a in ancore for s in risolvi(a, E)}
        giallo = bool(sigilli) and any(sigilli.get(s) not in (None, E["sim"][s]["hash"]) for s in sids)
        return {"stato": "rotto" if rot else "da riverificare" if giallo else "ok", "rotte": rot}, sids
    testo = lambda sa, sb: (prova(E, sa, sb) or ("",))[0]
    stati, archi, sids, usati = {}, {}, {}, set()
    def livello(pre, nodi, ar):  # inner steps have no anchors of their own: they take the state of their block, and their arrows are not checked
        for n in nodi: stati[pre + n["id"]], sids[pre + n["id"]] = stati[pre[:-1]], set()
    ext = {b["id"] for b in spec["blocchi"] if b.get("esterno")}  # sistemi fuori dal codice (sito, servizi): dichiarati, non verificabili
    for b in spec["blocchi"]:
        stati[b["id"]], sids[b["id"]] = ({"stato": "ok", "rotte": []}, set()) if b["id"] in ext else stato(ancore_blocco(b)); usati |= sids[b["id"]]
    for a, b, *rest in spec.get("archi", []):
        ev = rest[2] if len(rest) > 2 else ""  # optional 5th item: the evidence the extractor found (a graph call, a path mention, shared identifiers)
        archi[f"{a}>{b}"] = "relazione dichiarata con un sistema esterno (non verificabile nel codice)" if {a, b} & ext else ev or testo(sids[a], sids[b])
    for b in spec["blocchi"]:
        if b.get("interno"): livello(b["id"] + "/", b["interno"]["nodi"], b["interno"].get("archi", []))
    usato = {b["id"]: [x["id"] for x in spec["blocchi"] if x["id"] != b["id"] and prova(E, sids[x["id"]], sids[b["id"]])]
             for b in spec["blocchi"] if b.get("trasversale")}
    esterni = {}  # per ogni nodo interno senza frecce interne: le sue relazioni vere (max 3) con altri blocchi, cosi' si capisce cos'e'
    for b in spec["blocchi"]:
        if not b.get("interno"): continue
        conn = {x for a, c, *_ in b["interno"].get("archi", []) for x in (a, c)}
        for n in b["interno"]["nodi"]:
            if n["id"] in conn: continue
            s, rel = sids[f"{b['id']}/{n['id']}"], []
            for x in spec["blocchi"]:
                if x["id"] == b["id"] or x.get("trasversale"): continue
                info = {"altro": x["id"], "titolo": x["testo"].split("|")[0], "d": x.get("descrizione", ""), "da": n["id"]}
                o, i = prova(E, s, sids[x["id"]]), prova(E, sids[x["id"]], s)
                if o: rel.append({**info, "dir": "out", "et": o[1], "pr": o[0]})
                if i: rel.append({**info, "dir": "in", "et": i[1], "pr": i[0]})
            esterni.setdefault(b["id"], []).extend(rel[:3])
    infra = tuple(spec.get("infrastruttura", []))
    tutti = [s for s in E["sim"] if not s.endswith(":<modulo>") and not E["sim"][s]["file"].startswith(infra)]
    scoperti = [s for s in tutti if s not in usati]
    return {"stati": stati, "archi": archi, "usato": usato, "esterni": esterni, "sids": {k: sorted(v) for k, v in sids.items()},
            "copertura": {"tot": len(tutti), "coperti": len(tutti) - len(scoperti), "scoperti": scoperti}}


def costruisci(spec, ver=None, posiz=None):
    posiz = posiz or {}
    blocchi = [{**b, "codice": b.get("codice") or ", ".join(ancore_blocco(b))[:400]} for b in spec["blocchi"]]
    vt, meta = vista("", spec.get("titolo", "Pipeline"), blocchi, spec.get("archi", []), ver, posiz.get(""), spec.get("gruppi"))
    det = {}
    for b in spec["blocchi"]:
        i = b.get("interno")
        if i:
            v, m2 = vista(b["id"], i.get("titolo") or b["testo"].split("|")[0], i["nodi"], i.get("archi", []), ver, posiz.get(b["id"]), i.get("gruppi"), (ver or {}).get("esterni", {}).get(b["id"]))
            det[b["id"]] = {"titolo": b["testo"].split("|")[0], "vista": v}; meta.update(m2)
    return {"titolo": spec.get("titolo", "Pipeline"), "vista": vt, "meta": meta, "dettagli": det,
            "copertura": ver["copertura"] if ver else None}


